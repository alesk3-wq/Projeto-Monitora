{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git/**",
      ".superpowers/**",
      "docs/**",
      "CLAUDE.md",
      "**/.*"
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|css)",
        "headers": [ { "key": "Cache-Control", "value": "no-cache" } ]
      },
      {
        "source": "/",
        "headers": [ { "key": "Cache-Control", "value": "no-cache" } ]
      }
    ]
  }
}
